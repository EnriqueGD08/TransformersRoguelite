[ext_resource type="Texture2D" path="res://assets/ui/skills/sword.png" id="ic_sword"]

[sub_resource type="Resource" id="item_hp"]
script = ExtResource("itm")
id = "hp"
display_name = "Blindaje de energon"
description = "+30 de vida máxima (y te cura esa cantidad)."
icon = ExtResource("ic_heart")
kind = "stat"
target_stat = "max_hp"
effect_value = 30
base_price = 40
price_step = 20
max_purchases = 8

[sub_resource type="Resource" id="item_damage"]
script = ExtResource("itm")
id = "damage"
display_name = "Munición de energon"
