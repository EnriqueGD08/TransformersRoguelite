[resource]
script = ExtResource("cat")
items = Array[ExtResource("itm")]([SubResource("item_hp"), SubResource("item_damage"), SubResource("item_speed"), SubResource("item_dodge"), SubResource("item_armor"), SubResource("item_regen"), SubResource("item_range"), SubResource("item_magnet"), SubResource("item_lifesteal"), SubResource("item_last_stand"), SubResource("item_kill_cdr")])
