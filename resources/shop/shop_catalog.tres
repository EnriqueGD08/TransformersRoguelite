[gd_resource type="Resource" script_class="ShopCatalog" load_steps=25 format=3]

[ext_resource type="Script" path="res://scripts/systems/shop_catalog.gd" id="cat"]
[ext_resource type="Script" path="res://scripts/systems/shop_item_data.gd" id="itm"]
[ext_resource type="Texture2D" path="res://assets/ui/skills/boot.png" id="ic_boot"]
[ext_resource type="Texture2D" path="res://assets/ui/skills/clock.png" id="ic_clock"]
[ext_resource type="Texture2D" path="res://assets/ui/skills/cross.png" id="ic_cross"]
[ext_resource type="Texture2D" path="res://assets/ui/skills/crosshair.png" id="ic_crosshair"]
[ext_resource type="Texture2D" path="res://assets/ui/skills/drop.png" id="ic_drop"]
[ext_resource type="Texture2D" path="res://assets/ui/skills/feather.png" id="ic_feather"]
